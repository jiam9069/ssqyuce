# =====================================================================
# 双色球系统环境变量模板
# 复制为 .env 后填写，.env 已加入 .gitignore，不会进入仓库/镜像
#   cp .env.example .env && 编辑
# Docker Compose 部署：compose 自动读取同目录 .env
# 本地 venv 运行：   source .env（或 export 各变量）
# =====================================================================

# ---------- LLM 通道（必填，否则自动降级为纯统计模型） ----------
# 主通道：OpenAI 兼容端点（DeepSeek / 智谱 / 通义 / 任意兼容服务均可）
LOTT_LLM_BASE_URL=https://your-provider.example.com/v1
LOTT_LLM_API_KEY=sk-your-key-here
LOTT_LLM_MODEL=your-model-name

# ---------- 多模型自定义（可选） ----------
# 1) 同一通道下使用多个模型（逗号分隔），采样时按模型轮转
# LOTT_LLM_MODEL_LIST=model-a,model-b,model-c
# 2) 完全独立的附加通道（JSON 数组；name 为展示名，base_url/api_key/model 各自独立）
# LOTT_LLM_EXTRA_MODELS=[{"name":"my-deepseek","base_url":"https://api.deepseek.com/v1","api_key":"sk-xxx","model":"deepseek-chat"},{"name":"my-glm","base_url":"https://open.bigmodel.cn/api/paas/v4","api_key":"xxx","model":"glm-4.5"}]

# ---------- 运行参数（可选，均为默认值） ----------
LOTT_LLM_SAMPLES=3        # LLM 采样轮数（并发）
LOTT_N_TICKETS=10         # 输出注数
LOTT_SCHEDULER=1          # 开奖日自动闭环
LOTT_BOOT_PREDICT=1       # 启动自动生成预测
# LOTT_LLM_DISABLED=1     # 强制关闭 LLM（纯统计）

# ---------- M4.2 方法 A/B 开关（可选，默认全部启用） ----------
# LOTT_METHODS：逗号/空格分隔。令牌可写族名（stat / llm / ml / uniform）或全名（stat:freq）。
#   含 - 前缀 = 拒绝列表（关掉这些）；无 - 前缀 = 允许列表（只保留这些）。
# LOTT_METHODS=-llm             # 仅关闭 LLM 通道
# LOTT_METHODS=stat,ml          # 仅保留统计基线 + ML
# LOTT_METHODS=stat:freq,llm    # 仅保留 stat:freq 与全部 LLM
# LOTT_METHOD_MODE=production   # production（默认，严格按开关过滤）/ research（忽略开关、全部启用，供对比实验）

# ---------- M3 研究（可选） ----------
# LLM 离线评估：三通道 walk-forward 对比 stat / stat+llm / random
LOTT_LLM_EVAL_ISSUES=60          # walk-forward 窗口期数
LOTT_LLM_EVAL_TICKETS=5          # 每期每通道注数
LOTT_LLM_EVAL_SEED=42            # stat/random 通道随机种子（可复现）
# LOTT_LLM_EVAL_MODEL=轻量模型名   # 评估期间限定单模型（控制成本）
LOTT_LLM_EVAL_PRICE_PER_1M=1.0   # 每百万 token 估算价（USD，仅展示）
# LOTT_LLM_VERIFY_MODEL=other-model  # 第三轮校验模型（M3.2 接入）
LOTT_LLM_VERIFY=1                 # 第三轮校验开关：1=开（默认，生产启用）/ 0=关（评估口径关闭）