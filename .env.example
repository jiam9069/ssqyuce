# =====================================================================
# 双色球系统环境变量模板
# 复制为 .env 后填写，.env 已加入 .gitignore，不会进入仓库/镜像
#   cp .env.example .env && 编辑
# Docker Compose 部署：compose 自动读取同目录 .env
# 本地 venv 运行：   source .env（或 export 各变量）
# =====================================================================

# ---------- LLM 通道（必填，否则自动降级为纯统计模型） ----------
# 主通道：OpenAI 兼容端点（DeepSeek / 智谱 / 通义 / 任意兼容服务均可）
LOTT_LLM_BASE_URL=https://your-provider.example.com/v1
LOTT_LLM_API_KEY=sk-your-key-here
LOTT_LLM_MODEL=your-model-name

# ---------- 多模型自定义（可选） ----------
# 1) 同一通道下使用多个模型（逗号分隔），采样时按模型轮转；观察轮也会依次容错
# LOTT_LLM_MODEL_LIST=model-a,model-b,model-c
# 2) 完全独立的附加通道（JSON 数组；name 为展示名，base_url/api_key/model 各自独立）
# LOTT_LLM_EXTRA_MODELS=[{"name":"my-deepseek","base_url":"https://api.deepseek.com/v1","api_key":"sk-xxx","model":"deepseek-chat"},{"name":"my-glm","base_url":"https://open.bigmodel.cn/api/paas/v4","api_key":"xxx","model":"glm-4.5"}]

# ---------- 请求级附加参数（可选，解决推理型模型烧光 max_tokens 问题） ----------
# LOTT_LLM_EXTRA_BODY：JSON 对象，合并进所有模型的请求体（如降低思考强度）
# LOTT_LLM_EXTRA_BODY_MAP：按模型名覆盖（叠加在 EXTRA_BODY 之上）
# 示例（api.b.ai 网关：glm 需 low effort；qwen 需显式关思考）：
# LOTT_LLM_EXTRA_BODY={"reasoning_effort":"low"}
# LOTT_LLM_EXTRA_BODY_MAP={"qwen3.8-flash":{"enable_thinking":false,"reasoning_effort":"none"}}

# ---------- 运行参数（可选，均为默认值） ----------
LOTT_LLM_SAMPLES=3        # LLM 采样轮数（并发）
LOTT_LLM_TIMEOUT=60       # 单次 LLM 请求超时（秒）
LOTT_LLM_LONG_TIMEOUT=180 # 大输出预算（推理型模型）单次调用的宽松超时（秒）；
                          # 预算抬到 LOTT_LLM_MAX_TOKENS 后单次要跑 30~120s，
                          # 沿用 60s 会先被判读取超时、白白重试一轮
LOTT_LLM_MAX_TOKENS=32000 # 推理型模型输出预算上限：检测到“只返回 reasoning_content、
                          # content 为空”时，一次把 max_tokens 抬到该值并注入
                          # thinking:disabled 重试；成功后记住该模型可行预算
                          # （data/llm_budget.json）。设 0 = 关闭自适应。
                          # 注意：重推理模型一整轮预测（观察+选号）约 75s，
                          # 必须同步放宽 LOTT_LLM_TOTAL_TIMEOUT。
LOTT_LLM_TOTAL_TIMEOUT=75 # 单次预测 LLM 阶段总预算（秒）；超时即判定“大模型超时”，
                          # Web 预测直接提示失败、不降级。须小于反代/CDN 超时（如 Cloudflare 100s）；
                          # 使用重推理模型（如 agent-router/deepseek-v4-flash）时建议 180+
LOTT_N_TICKETS=5          # 输出注数（V11 起默认 5 注，用户指令；可手动改）
# LOTT_LLM_ONLY_OUTPUT=0  # 【V10 起默认 0】
                          # 0（默认）=LLM 只提供候选，出号仍由确定性排序 + 蓝球覆盖计划决定
                          # 1=LLM 产出几注就出几注，不用统计/ML 补齐（紧急回退用）
                          # 注：即使设为 1，若 LLM 族被 LOTT_METHODS 关闭，也绝不出 LLM 号
                          #     （统一由 methods.resolve_channels() 判定）
LOTT_SCHEDULER=1          # 开奖日自动闭环
LOTT_BOOT_PREDICT=1       # 启动自动生成预测
# LOTT_LLM_DISABLED=1     # 强制关闭 LLM（纯统计）

# ---------- M4.5 工程安全（可选） ----------
# 配置后所有 /api/* 请求必须带 Authorization: Bearer <值>；留空则兼容开放访问。
# LOTT_TOKEN=仅写入本机 .env，不要提交仓库

# ---------- M4.4 多源对账（可选） ----------
# 备用源应返回与主源相同的 ssq.TXT 31 字段格式；只读比较，不覆盖主库。
# LOTT_BACKUP_DATA_URL=https://backup.example.com/ssq.TXT

# ---------- M4.2 方法 A/B 开关（可选，默认全部启用） ----------
# LOTT_METHODS：逗号/空格分隔。令牌可写族名（stat / llm / ml / uniform）或全名（stat:freq）。
#   含 - 前缀 = 拒绝列表（关掉这些）；无 - 前缀 = 允许列表（只保留这些）。
# LOTT_METHODS=-llm             # 仅关闭 LLM 通道
# LOTT_METHODS=stat,ml          # 仅保留统计基线 + ML
# LOTT_METHODS=stat:freq,llm    # 仅保留 stat:freq 与全部 LLM
# LOTT_METHOD_MODE=production   # production（默认，严格按开关过滤）/ research（忽略开关、全部启用，供对比实验）

# ---------- M4.3 开奖通知（可选；未配置时不发送） ----------
# 企业微信机器人 / Server酱兼容 Webhook（失败不阻塞开奖对照）
# LOTT_NOTIFY_WEBHOOK=https://example.com/webhook
# SMTP 邮件通知（字段齐全才启用）
# LOTT_NOTIFY_EMAIL_SMTP_HOST=smtp.example.com
# LOTT_NOTIFY_EMAIL_SMTP_PORT=587
# LOTT_NOTIFY_EMAIL_SMTP_TLS=1
# LOTT_NOTIFY_EMAIL_SMTP_USER=notify@example.com
# LOTT_NOTIFY_EMAIL_SMTP_PASSWORD=仅写入本机 .env，不要提交仓库
# LOTT_NOTIFY_EMAIL_FROM=notify@example.com
# LOTT_NOTIFY_EMAIL_TO=you@example.com

# ---------- M3 研究（可选） ----------
# LLM 离线评估：三通道 walk-forward 对比 stat / stat+llm / random
LOTT_LLM_EVAL_ISSUES=60          # walk-forward 窗口期数
LOTT_LLM_EVAL_TICKETS=5          # 每期每通道注数
LOTT_LLM_EVAL_SEED=42            # stat/random 通道随机种子（可复现）
# LOTT_LLM_EVAL_MODEL=轻量模型名   # 评估期间限定单模型（控制成本）
LOTT_LLM_EVAL_PRICE_PER_1M=1.0   # 每百万 token 估算价（USD，仅展示）
# LOTT_LLM_VERIFY_MODEL=other-model  # 第三轮校验模型（M3.2 接入）
LOTT_LLM_VERIFY=1                 # 第三轮校验开关：1=开（默认，生产启用）/ 0=关（评估口径关闭）
# ---------- V4 诚实口径 ----------
# 方法比较的最小期数门槛：低于此期数前端不给出「最佳方法」结论，
# 也不把命中率/中奖率单独展示为能力指标（与 config.METHOD_RECOMMENDATION_MIN_ISSUES 同一常量，
# 经 /api/info 的 method_min_issues 下发到前端，避免前后端各写一个数）。
LOTT_METHOD_RECOMMENDATION_MIN_ISSUES=60
# 说明：双色球为独立随机事件，本系统不承诺中奖率。
# /api/rigor/randomness 与 /api/rigor/signal 依赖 lottery/rigor.py；
# 该模块缺失时这两个端点返回 503 + available=false，不影响服务启动与其它功能。
# LOTT_STRICT_MODE=1  # V11 严格模式：必须 LLM 分析规律出号，否则不出号。
#   开启前确认：LLM 网关可用（data/llm_config.json）+ 规律库有 usable 规律。
#   任一不满足 → 拒绝出号（返回明确原因），绝不静默降级为统计基线。
#   默认 0 = 关（保持 stat/ml 兜底的诚实边界）。

# ---------------------------------------------------------------------------
# 多用户鉴权（W08 / MU-1 / MU-2）—— P1-9：这一段此前**整段缺失**
# ---------------------------------------------------------------------------
# 审计发现：`.env.example` 里没有任何鉴权相关键，于是按 example 部署的人
# 得到一个"看起来配置完整、实际没有鉴权"的实例。Compose 里虽有默认值，
# 但 example 才是部署者的清单，两者不齐就是漂移。
#
# 鉴权模式：enforce = deny-by-default（**上线必须**）；off = 只解析不拦截（灰度）。
# V36 起 compose 默认已是 enforce；此处显式列出，避免"以为默认是 off"。
LOTT_AUTH_MODE=enforce
# 一次性引导口令：把 bootstrap 行升级为主管理员。**没有默认值**，
# 不填则引导通道整体关闭。引导成功后必须从 .env 删除并重启。
# LOTT_BOOTSTRAP_TOKEN=
# 每用户 API Key 的 Fernet 主密钥。留空 = 容器首次启动自动生成
# data/.secret_key（0600）。**换掉它会让已保存的用户 Key 全部解不开**，
# 生产建议显式固定并纳入备份（但不要和数据文件放在同一份备份里）。
# LOTT_MASTER_KEY=
# 会话有效期（秒），默认 14 天。
LOTT_SESSION_TTL=1209600
# 会话 Cookie 名。`__Host-` 前缀要求 Secure + Path=/，生产（HTTPS）下保持默认；
# 本地纯 http 调试才降级为 ssq_sid（否则浏览器不保存 Secure Cookie，登录会失败）。
LOTT_COOKIE_NAME=__Host-ssq_sid
# Cookie 的 Secure 属性。生产必须 1；纯 http 本地调试设 0。
LOTT_COOKIE_SECURE=1

# ---------------------------------------------------------------------------
# LLM 上游地址安全（P1-2）
# ---------------------------------------------------------------------------
# 默认 0：拒绝把内网/保留地址（127/10/172.16-31/192.168/169.254/CGNAT 等）
# 作为 LLM base_url —— 服务器会替用户去 POST 该地址，构成 SSRF。
# 只有确实要连**自建内网模型**时才设 1（它是显式的风险接受，不是默认值）。
LOTT_LLM_ALLOW_PRIVATE_URL=0

# ---------------------------------------------------------------------------
# 出号随机种子（P0-4）
# ---------------------------------------------------------------------------
# 固定种子保证"同一期 + 同一份数据"给出同一批票，也让离线回测可复现
# （未固定时同 seed 两次回测的 delta_red_hits 会跨过判决阈值）。
# 需要"重抽一批"时用 regenerate=true 或显式传不同 rng，而不是靠系统熵。
LOTT_PREDICT_SEED=20261024
